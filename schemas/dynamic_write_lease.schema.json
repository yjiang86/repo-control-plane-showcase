{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-host dynamic coordination lock",
  "$comment": "A lock serializes concurrent path or Git mutations on one host.",
  "type": "object",
  "required": [
    "schema_version",
    "object_kind",
    "lock_id",
    "lock_kind",
    "task",
    "owner",
    "base_head",
    "paths",
    "acquired_at",
    "expires_at",
    "ttl_seconds",
    "nonce"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "object_kind": {"const": "DYNAMIC_COORDINATION_LOCK"},
    "lock_id": {"$ref": "#/$defs/text"},
    "lock_kind": {"enum": ["PATH_LOCK", "GIT_MUTATION_LOCK"]},
    "task": {"$ref": "#/$defs/text"},
    "owner": {"$ref": "#/$defs/text"},
    "base_head": {"$ref": "#/$defs/git_oid"},
    "paths": {
      "type": "array",
      "items": {"$ref": "#/$defs/path_rule"}
    },
    "acquired_at": {"$ref": "#/$defs/utc_timestamp"},
    "expires_at": {"$ref": "#/$defs/utc_timestamp"},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "nonce": {"$ref": "#/$defs/text"},
    "git_context": {
      "type": "object",
      "$comment": "Host-local canonical absolute root and per-worktree Git directory, additionally checked by the runtime. Old readers reject this Git-only extension rather than downgrade it.",
      "required": ["repo_root", "git_dir"],
      "properties": {
        "repo_root": {"$ref": "#/$defs/absolute_path"},
        "git_dir": {"$ref": "#/$defs/absolute_path"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"lock_kind": {"const": "PATH_LOCK"}},
        "required": ["lock_kind"]
      },
      "then": {"properties": {"paths": {"minItems": 1}}, "not": {"required": ["git_context"]}},
      "else": {
        "properties": {
          "paths": {"maxItems": 0},
          "ttl_seconds": {"maximum": 900}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "absolute_path": {
      "allOf": [
        {"$ref": "#/$defs/text"},
        {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "relative_path": {
      "type": "string",
      "$comment": "Structural portability check only. The runtime additionally normalizes Unicode/case, rejects Windows device and ambiguous segments, and rejects existing symlink or reparse traversal.",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*:)(?!.*(?:^|/)\\.[Gg][Ii][Tt](?:/|$))(?!.*\\/$).+$"
    },
    "path_rule": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["exact", "prefix"]},
        "path": {"$ref": "#/$defs/relative_path"}
      },
      "additionalProperties": false
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
